generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  ELIGIBILITY_CHECK
  OFFER_SELECTED
  KYC_PENDING
  APPROVED
  DISBURSED
  REJECTED
  CANCELLED
}

enum LoanPurpose {
  PERSONAL
  HOME_RENOVATION
  EDUCATION
  MEDICAL
  DEBT_CONSOLIDATION
  OTHER
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  fullName        String
  phone           String?
  creditScore     Int?
  role            UserRole          @default(USER)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  applications    LoanApplication[]
  auditLogs       AuditLog[]

  @@index([createdAt])
}

model Lender {
  id              String      @id @default(cuid())
  name            String      @unique
  slug            String      @unique
  active          Boolean     @default(true)
  baseRate        Decimal     @db.Decimal(5, 2)
  processingFee   Decimal     @db.Decimal(6, 3)
  minAmount       Decimal     @db.Decimal(14, 2)
  maxAmount       Decimal     @db.Decimal(14, 2)
  maxTenureMonths Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  offers          LoanOffer[]

  @@index([active])
}

model LoanApplication {
  id              String            @id @default(cuid())
  userId          String
  amount          Decimal           @db.Decimal(14, 2)
  tenureMonths    Int
  creditScore     Int?
  purpose         LoanPurpose
  status          ApplicationStatus @default(DRAFT)
  selectedOfferId String?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers          LoanOffer[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model LoanOffer {
  id               String           @id @default(cuid())
  applicationId    String?
  lenderId         String
  annualRate       Decimal          @db.Decimal(5, 2)
  processingFeePct Decimal          @db.Decimal(6, 3)
  emi              Decimal          @db.Decimal(14, 2)
  totalInterest    Decimal          @db.Decimal(14, 2)
  totalPayable     Decimal          @db.Decimal(14, 2)
  eligibilityScore Int              @default(0)
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  application      LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lender           Lender           @relation(fields: [lenderId], references: [id])

  @@index([applicationId, eligibilityScore])
  @@index([lenderId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
